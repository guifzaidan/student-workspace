# Credenciais do Turso. Copie este arquivo para `.env` e preencha lá.
# O `.env` está no .gitignore; este aqui é versionado, então nunca escreva
# valor real nele.
#
# Onde achar os valores:
#   turso db show <nome-do-banco> --url
#   turso db tokens create <nome-do-banco>

TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# Opcional, só em desenvolvimento: o Chrome que gera o PDF dos arquivos.
# Sem esta linha a API procura o Google Chrome nos lugares de costume
# (Windows, macOS e Linux). Na Vercel quem gera é o @sparticuz/chromium.
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# A chave da API do Claude, para o assistente de plano de estudos ler os
# arquivos anexados e montar o plano. Crie em console.anthropic.com. Sem ela o
# assistente funciona com as regras do app, sem ler arquivos nem perguntar.
ANTHROPIC_API_KEY=

# A chave do Gemini, alternativa ao Claude no mesmo assistente. Sem a chave do
# Claude, quem responde é o Gemini; com as duas, o Gemini entra quando o Claude
# falha (chave recusada, limite, queda). Crie em aistudio.google.com/apikey.
GEMINI_API_KEY=
# Opcional: outro modelo do Gemini. O padrão é gemini-flash-latest.
# GEMINI_MODEL=gemini-pro-latest
