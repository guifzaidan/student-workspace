# Credenciais do Turso. Copie este arquivo para `.env` e preencha lá.
# O `.env` está no .gitignore; este aqui é versionado, então nunca escreva
# valor real nele.
#
# Onde achar os valores:
#   turso db show <nome-do-banco> --url
#   turso db tokens create <nome-do-banco>

TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=
